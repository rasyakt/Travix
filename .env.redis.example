# Redis Configuration for Production
# Copy these to your .env file

# Session Driver (use redis for better performance)
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Cache Driver
CACHE_STORE=redis

# Queue Driver
QUEUE_CONNECTION=redis

# Redis Connection
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Redis Cache Database
REDIS_CACHE_DB=1

# Redis Queue Database  
REDIS_QUEUE_DB=2

# Redis Session Database
REDIS_SESSION_CONNECTION=session
REDIS_SESSION_DB=3
